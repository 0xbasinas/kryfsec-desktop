{
  "name": "cyberjourney",
  "productName": "CyberJourney",
  "version": "0.1.0",
  "description": "CyberJourney - track and document your cybersecurity learning journey",
  "main": "out/main/main.js",
  "author": {
    "name": "0xbasinas",
    "email": "241305723+0xbasinas@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "package:win": "npm run build && ELECTRON_BUILDER_WINE_TOOLSET_DIR=$PWD/scripts/nsis-no-wine electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "screenshots": "bash scripts/screenshots.sh",
    "screenshots:components": "node scripts/component-shots.cjs && python3 scripts/component-sheet.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-code-block": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "nanoid": "^6.0.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "refractor": "^5.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "zustand": "^5.0.16"
  },
  "desktopName": "cyberjourney.desktop"
}
